---
import { Image } from 'astro:assets';
import me from '../assets/me.jpg';
import { profile } from '../data/resume';

interface Props {
	title: string;
	description: string;
	noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="light" />
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex" />}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600&display=swap"
		/>
		<title>{title}</title>
	</head>
	<body>
		<main>
			<header class="intro">
				<div class="who">
					<Image src={me} alt={profile.name} width={112} height={112} class="portrait" loading="eager" />
					<div>
						<h1>{profile.name}</h1>
						<p class="muted">{profile.headline}</p>
						<p class="muted">{profile.location}</p>
					</div>
				</div>
				<ul class="contact">
					<li><a href={`mailto:${profile.email}`}>{profile.email}</a></li>
					<li class="screen-only"><a href={profile.linkedin}>LinkedIn</a></li>
					<li class="screen-only"><a href={`https://github.com/${profile.github}`}>GitHub</a></li>
				</ul>
			</header>

			<slot />
		</main>

		<footer class="muted">
			<p>© {new Date().getFullYear()} {profile.name}</p>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		--paper: #f6f7f9;
		--ink: #24292f;
		--muted: #67707a;
		--rule: #dfe3e8;
		--surface: #ffffff;
		--link: #1a7f4b;
		color-scheme: light;
	}

	* {
		box-sizing: border-box;
	}

	html {
		-webkit-text-size-adjust: 100%;
	}

	body {
		margin: 0;
		background: var(--paper);
		color: var(--ink);
		font-family: 'Hanken Grotesk', system-ui, sans-serif;
		font-size: 0.90625rem;
		line-height: 1.6;
	}

	a {
		color: inherit;
		text-decoration-color: var(--rule);
		text-decoration-thickness: 1px;
		text-underline-offset: 0.22em;
	}

	a:hover {
		color: var(--link);
		text-decoration-color: currentColor;
	}

	:focus-visible {
		outline: 2px solid var(--link);
		outline-offset: 2px;
	}

	.muted {
		color: var(--muted);
	}

	main,
	body > footer {
		max-width: 40rem;
		margin: 0 auto;
		padding: 0 1rem;
	}

	main p,
	main h1,
	main h2,
	main h3,
	body > footer p {
		margin: 0;
	}

	.intro {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: center;
		gap: 0.5rem 2rem;
		padding: 4rem 0 1.5rem;
	}

	@media (min-width: 640px) {
		.intro {
			padding-top: 6rem;
		}
	}

	.who {
		display: flex;
		align-items: center;
		gap: 0.875rem;
	}

	.portrait {
		width: 3rem;
		height: 3rem;
		border-radius: 50%;
		object-fit: cover;
	}

	h1 {
		font-size: 1.125rem;
		font-weight: 600;
		line-height: 1.3;
	}

	.contact {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.lede {
		margin-bottom: 2rem;
		font-size: 1rem;
	}

	main section {
		margin-top: 3rem;
	}

	main section > h2 {
		margin-bottom: 1rem;
		font-size: 0.8125rem;
		font-weight: 500;
		color: var(--muted);
	}

	main h3 {
		font-size: inherit;
		font-weight: 600;
	}

	/* Name on the left, dates or stack on the right. */
	.line {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: baseline;
		gap: 0 1rem;
	}

	.jobs,
	.projects {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
	}

	.jobs {
		gap: 1.75rem;
	}

	.projects {
		gap: 1.125rem;
	}

	.jobs ul {
		margin: 0.5rem 0 0;
		padding-left: 1rem;
	}

	.jobs ul li + li {
		margin-top: 0.25rem;
	}

	.jobs ul li::marker {
		color: var(--muted);
	}

	.pairs {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0 1.5rem;
		margin: 0;
	}

	.pairs dt {
		color: var(--muted);
	}

	.pairs dd {
		margin: 0 0 0.5rem;
	}

	@media (min-width: 560px) {
		.pairs {
			grid-template-columns: 9rem 1fr;
			row-gap: 0.375rem;
		}

		.pairs dd {
			margin: 0;
		}
	}

	.case-title {
		margin-bottom: 0.75rem;
	}

	body > footer {
		padding-top: 4rem;
		padding-bottom: 3rem;
		font-size: 0.8125rem;
	}

	@page {
		margin: 0.5in;
	}

	@media print {
		body {
			background: #fff;
			font-size: 9.5pt;
			line-height: 1.45;
		}

		.screen-only,
		.graph,
		body > footer {
			display: none;
		}

		.intro {
			padding: 0 0 1rem;
		}

		.lede {
			margin-bottom: 0;
			font-size: inherit;
		}

		main section {
			margin-top: 1.125rem;
		}

		main section > h2 {
			margin-bottom: 0.5rem;
			break-after: avoid;
		}

		.jobs {
			gap: 0.75rem;
		}

		.projects {
			gap: 0.5rem;
		}

		.jobs > li,
		.projects > li,
		.pairs dd {
			break-inside: avoid;
		}

		.jobs ul li + li {
			margin-top: 0.125rem;
		}

		.pairs {
			row-gap: 0.25rem;
		}
	}
</style>
