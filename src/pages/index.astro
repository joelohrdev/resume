---
import Base from '../layouts/Base.astro';
import ContributionGraph from '../components/ContributionGraph.astro';
import { profile, jobs, projects, caseStudy } from '../data/resume';

const description = `${profile.name} is a ${profile.role} in ${profile.location}, building compliance software and AI tools for car dealerships with Laravel.`;
---

<Base title={`${profile.name}, ${profile.headline}`} description={description}>
	<p class="lede">{profile.summary}</p>

	<section aria-labelledby="work">
		<h2 id="work">Selected work</h2>
		<ul class="projects">
			{projects.map((p) => (
				<li>
					<div class="line">
						<h3>{p.url ? <a href={p.url}>{p.name}</a> : p.name}</h3>
						<p class="muted">{p.stack}</p>
					</div>
					<p>{p.note}</p>
				</li>
			))}
		</ul>
	</section>

	<section aria-labelledby="case-study">
		<h2 id="case-study">Case study</h2>
		<h3 class="case-title">{caseStudy.title}</h3>
		<dl class="pairs">
			{caseStudy.parts.map((part) => (
				<>
					<dt>{part.label}</dt>
					<dd>{part.text}</dd>
				</>
			))}
		</dl>
	</section>

	<section aria-labelledby="experience">
		<h2 id="experience">Experience</h2>
		<ol class="jobs">
			{jobs.map((job) => (
				<li>
					<div class="line">
						<h3>{job.company}</h3>
						<p class="muted">
							{job.start.slice(-4)} to {job.end === 'Present' ? 'now' : job.end.slice(-4)}
						</p>
					</div>
					<p class="muted">{job.title}</p>
					<p>{job.summary}</p>
				</li>
			))}
		</ol>
	</section>

	<ContributionGraph user={profile.github} />
</Base>
