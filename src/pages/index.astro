---
import { Image } from 'astro:assets';
import ContributionGraph from '../components/ContributionGraph.astro';
import me from '../assets/me.jpg';
import { profile, jobs, projects, skills } from '../data/resume';

const description = `${profile.name} is a ${profile.role} in ${profile.location}, building compliance software with Laravel, Inertia and Vue.`;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="light" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600&display=swap"
		/>
		<title>{profile.name}, {profile.role}</title>
	</head>
	<body>
		<main>
			<header class="intro">
				<div class="who">
					<Image src={me} alt={profile.name} width={112} height={112} class="portrait" loading="eager" />
					<div>
						<h1>{profile.name}</h1>
						<p class="muted">{profile.role}, {profile.location}</p>
					</div>
				</div>
				<ul class="contact">
					<li><a href={`mailto:${profile.email}`}>{profile.email}</a></li>
					<li><a href={profile.linkedin}>LinkedIn</a></li>
					<li><a href={`https://github.com/${profile.github}`}>GitHub</a></li>
				</ul>
			</header>

			<p class="lede">
				I'm the only developer at Automotive Risk Management Partners, where I build and run their compliance
				software with Laravel, Inertia and Vue. Before that I spent almost twelve years building WordPress
				sites for local businesses.
			</p>

			<ContributionGraph user={profile.github} />

			<section aria-labelledby="experience">
				<h2 id="experience">Experience</h2>
				<ol class="jobs">
					{jobs.map((job) => (
						<li>
							<div class="line">
								<h3>{job.company}</h3>
								<p class="muted">
									{job.start} to {job.end}
								</p>
							</div>
							<p class="muted">{job.title}</p>
							<ul>
								{job.points.map((p) => (
									<li>{p}</li>
								))}
							</ul>
						</li>
					))}
				</ol>
			</section>

			<section aria-labelledby="projects">
				<h2 id="projects">Projects</h2>
				<ul class="projects">
					{projects.map((p) => (
						<li>
							<div class="line">
								<h3>{p.url ? <a href={p.url}>{p.name}</a> : p.name}</h3>
								<p class="muted">{p.stack}</p>
							</div>
							<p>{p.note}</p>
						</li>
					))}
				</ul>
			</section>

			<section aria-labelledby="skills">
				<h2 id="skills">Skills</h2>
				<dl class="pairs">
					{skills.map((s) => (
						<>
							<dt>{s.group}</dt>
							<dd>{s.items.join(', ')}</dd>
						</>
					))}
				</dl>
			</section>
		</main>

		<footer class="muted">
			<p>© {new Date().getFullYear()} {profile.name}</p>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		--paper: #f6f7f9;
		--ink: #24292f;
		--muted: #67707a;
		--rule: #dfe3e8;
		--surface: #ffffff;
		--link: #1a7f4b;
		color-scheme: light;
	}

	* {
		box-sizing: border-box;
	}

	html {
		-webkit-text-size-adjust: 100%;
	}

	body {
		margin: 0;
		background: var(--paper);
		color: var(--ink);
		font-family: 'Hanken Grotesk', system-ui, sans-serif;
		font-size: 0.90625rem;
		line-height: 1.6;
	}

	a {
		color: inherit;
		text-decoration-color: var(--rule);
		text-decoration-thickness: 1px;
		text-underline-offset: 0.22em;
	}

	a:hover {
		color: var(--link);
		text-decoration-color: currentColor;
	}

	:focus-visible {
		outline: 2px solid var(--link);
		outline-offset: 2px;
	}

	.muted {
		color: var(--muted);
	}
</style>

<style>
	main,
	footer {
		max-width: 40rem;
		margin: 0 auto;
		padding: 0 1rem;
	}

	p,
	h1,
	h2,
	h3 {
		margin: 0;
	}

	.intro {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: center;
		gap: 1rem 2rem;
		padding: 4rem 0 1.5rem;
	}

	@media (min-width: 640px) {
		.intro {
			padding-top: 6rem;
		}
	}

	.who {
		display: flex;
		align-items: center;
		gap: 0.875rem;
	}

	.portrait {
		width: 3rem;
		height: 3rem;
		border-radius: 50%;
		object-fit: cover;
	}

	h1 {
		font-size: 1.125rem;
		font-weight: 600;
		line-height: 1.3;
	}

	.contact {
		display: flex;
		flex-wrap: wrap;
		gap: 0 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.lede {
		margin-bottom: 2rem;
		font-size: 1rem;
	}

	section {
		margin-top: 3rem;
	}

	section > h2 {
		margin-bottom: 1rem;
		font-size: 0.8125rem;
		font-weight: 500;
		color: var(--muted);
	}

	h3 {
		font-size: inherit;
		font-weight: 600;
	}

	/* Name on the left, dates or stack on the right. */
	.line {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: baseline;
		gap: 0 1rem;
	}

	.jobs,
	.projects {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
	}

	.jobs {
		gap: 1.75rem;
	}

	.projects {
		gap: 1.125rem;
	}

	.jobs ul {
		margin: 0.5rem 0 0;
		padding-left: 1rem;
	}

	.jobs ul li + li {
		margin-top: 0.25rem;
	}

	.jobs ul li::marker {
		color: var(--muted);
	}

	.pairs {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0 1.5rem;
		margin: 0;
	}

	@media (min-width: 560px) {
		.pairs {
			grid-template-columns: 9rem 1fr;
			row-gap: 0.375rem;
		}
	}

	.pairs dt {
		color: var(--muted);
	}

	.pairs dd {
		margin: 0 0 0.5rem;
	}

	@media (min-width: 560px) {
		.pairs dd {
			margin: 0;
		}
	}

	footer {
		padding-top: 4rem;
		padding-bottom: 3rem;
		font-size: 0.8125rem;
	}
</style>
